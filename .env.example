# ── Solana (Devnet) ─────────────────────────────────────────────
SOLANA_RPC=https://api.devnet.solana.com
# JSON byte-array keypair (solana-keygen new -o keypair.json --no-bip39-passphrase)
SOLANA_KEYPAIR=
# Deployed to Devnet (P1-T6)
VERITAS_PROGRAM_ID=CiGK2btZHdeW1U327ZLDhTQhDhP9TB6U16oG4a21YTUG

# ── Arc Testnet / Circle Gateway ────────────────────────────────
ARC_RPC=https://rpc.testnet.arc.network
# EVM private key (0x…) holding testnet USDC — https://faucet.circle.com
ARC_PRIVATE_KEY=
GATEWAY_API_URL=https://gateway-api-testnet.circle.com
# true = mock Circle settlement (tests never block on testnet flakiness)
MOCK_SETTLE=true

# ── Coordinator ─────────────────────────────────────────────────
COORDINATOR_PORT=3001
# Credential seller middleware verifies on fan-out requests (MVP auth)
COORDINATOR_API_KEY=
VERITAS_FACILITATOR_URL=http://localhost:3001
# Basis-points fee on verified purchases
VERITAS_FEE_BPS=200

# ── Database ────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/veritas

# Fee destination (Gateway address collecting Veritas fees)
VERITAS_FEE_ADDRESS=0x000000000000000000000000000000000000dEaD
