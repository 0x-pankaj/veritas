// Veritas off-chain mirror (PRODUCT.md §8). On-chain is the source of truth
// for verdicts/reputation/stake; this DB is a fast read/analytics mirror plus
// coordination state (quotes, rounds, settlements).

generator client {
  provider = "prisma-client"
  output   = "../apps/coordinator/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SellerStatus {
  ACTIVE
  SUSPENDED
}

enum VerifyMode {
  CONSENSUS
  CONTENT_ADDRESSED
  REPUTATION
}

enum QueryStatus {
  QUOTED
  FANOUT
  SETTLED_ONCHAIN // verdict recorded on Solana
  FAILED // no consensus / quorum abort
  DONE // winners' settlement submitted
}

enum SettlementStatus {
  PENDING // submitted to Gateway, TEE-credited
  AVAILABLE // batch-settled on Arc
  FAILED
}

model Seller {
  id            String       @id @default(cuid())
  solanaPubkey  String       @unique
  payoutAddress String // EVM address for Gateway settlement
  name          String
  endpoint      String
  price         String // USDC base units per call
  mode          VerifyMode   @default(CONSENSUS)
  // capability descriptor (PRODUCT §7.3)
  category      String
  coverage      String[] // e.g. ["BTC/USD", "ETH/USD"]
  schemaDesc    String
  freshnessSec  Int
  // reputation mirror (source of truth on-chain)
  reputation    Int          @default(500)
  stake         String       @default("0")
  served        Int          @default(0)
  matched       Int          @default(0)
  outliers      Int          @default(0)
  status        SellerStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())

  responses   Response[]
  settlements Settlement[]

  @@index([category, status])
  @@map("sellers")
}

model Query {
  id           String      @id // hex query id (32 bytes)
  buyer        String // buyer EVM address
  mode         VerifyMode
  k            Int
  maxPrice     String?
  feeAmount    String      @default("0")
  truth        String? // consensus truth (decimal string or hash)
  cost         String? // final settled cost
  status       QueryStatus @default(QUOTED)
  solanaReqPda String?
  solanaTx     String? // finalize_consensus signature
  createdAt    DateTime    @default(now())

  responses   Response[]
  settlements Settlement[]

  @@index([status, createdAt])
  @@map("queries")
}

model Response {
  id          String  @id @default(cuid())
  queryId     String
  sellerId    String
  valueOrHash String
  latencyMs   Int
  matched     Boolean?

  query  Query  @relation(fields: [queryId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@unique([queryId, sellerId])
  @@map("responses")
}

model Settlement {
  id        String           @id @default(cuid())
  queryId   String
  sellerId  String
  amount    String // USDC base units
  gatewayTx String?
  status    SettlementStatus @default(PENDING)
  createdAt DateTime         @default(now())

  query  Query  @relation(fields: [queryId], references: [id])
  seller Seller @relation(fields: [sellerId], references: [id])

  @@index([status])
  @@map("settlements")
}
